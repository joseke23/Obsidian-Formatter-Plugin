{
	"name": "obsidian-formatter",
	"version": "1.0.0",
	"description": "Personalised plugin to consistently apply and change formatting in my vault.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "jest --config jest.integration.config.ts"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jest": "^30.5.2",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"obsidian-integration-testing": "^17.10.0",
		"ts-jest": "^29.4.15",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"date-fns": "^4.4.0"
	}
}